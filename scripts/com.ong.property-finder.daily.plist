<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily scan — fires shortly after login, then twice more during the day.

  All three triggers are safe: daily.py keeps its own day-guard in
  data/daily_state.json and exits immediately when the day already completed a
  SUCCESSFUL poll. The extra calendar entries exist so a day whose first attempt
  failed (usually an unsolved Cloudflare challenge, or no network yet at login)
  gets retried without waiting for the next login.

  A LaunchAgent, not a LaunchDaemon, on purpose: the poll runs a HEADED Chrome
  window and needs the logged-in GUI session.

  Install:  bash scripts/install-daily-agent.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ong.property-finder.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/run-daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- Fire at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Retry windows for a day whose first attempt failed. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>__REPO__/output/daily_runs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/output/daily_runs/launchd.log</string>

    <!-- One-shot per trigger; never resurrect. -->
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
