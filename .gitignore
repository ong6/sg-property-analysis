# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# Browser data (generated at runtime)
chrome-profile/

# Output files (generated per analysis run)
output/*.json
output/*.md
output/*.csv
output/*.txt
output/run_*/
# Daily-scan digests + agent transcripts. Machine-local like every other output/
# artifact — the durable record of a daily run is the evaluation it writes to
# evaluations/ (tracked) and the store's daily-finds note.
output/daily/
output/daily_runs/
output/analyze_runs/

# Playwright MCP cache
.playwright-mcp/

# Poller runtime state (rewritten every cycle, machine-local)
data/poll_state.json
# Daily-scan runtime state (which days already ran — machine-local)
data/daily_state.json

# data/*.csv files are tracked deliberately — they are the data backbone
# (listings sheet, MMR/arena history, URA cache export, raw URA downloads)

# Runtime credential files (auto-generated)
cookies.json
user_agent.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Claude Code local config (skills ARE tracked — shared project runbooks)
.claude/settings.local.json
.claude/worktrees/

# DB backfill safety copies
*.bak
